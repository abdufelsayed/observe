(alias
 (name correctness)
 (deps
  dune-project
  (alias observe-core-contracts)
  (alias observe-lwt-contracts)
  (alias observe-lwt-unix-contracts)
  (alias observe-fs-contracts)
  (alias observe-fs-lwt-contracts)
  (alias observe-fs-lwt-unix-contracts)
  (alias package-installed-surfaces)))

