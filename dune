(rule
 (alias observe-core-installed-surface)
 (package observe)
 (deps
  observe.install
  %{lib:observe:observe.cmi}
  %{lib:observe:observe.mli}
  %{lib:observe:META}
  %{lib:observe:dune-package}
  test/core/interfaces/check_install_surface.sh
  test/core/interfaces/public_consumer.exe
  test/core/interfaces/ppx_consumer.exe
  test/core/interfaces/public_consumer.ml
  (source_tree test/core/interfaces/negative))
 (action
  (progn
   (run
    bash
    %{dep:test/core/interfaces/check_install_surface.sh}
    %{bin:ocamlfind}
    %{dep:observe.install}
    %{lib:observe:observe.cmi}
    %{lib:observe:observe.mli}
    %{lib:observe:META}
    %{lib:observe:dune-package}
    %{dep:test/core/interfaces/public_consumer.ml}
    test/core/interfaces/negative)
   (run %{exe:test/core/interfaces/public_consumer.exe})
   (run %{exe:test/core/interfaces/ppx_consumer.exe}))))

