type event = { value : int }

let event_t =
  let open Observe.Type in
  record "event" (fun value -> { value })
  |+ field "value" int (fun event -> event.value)
  |> sealr

type event_builder = {
  typed : event Observe.Schema.patch -> event Observe.Schema.patch;
}

let event_schema =
  Observe.Schema.record event_t
    ~builder:(fun _ -> { typed = Fun.id })

let _ =
  Observe.Logs.info (fun m ->
      m.typed ~using:event_schema { value = "not an int" })
