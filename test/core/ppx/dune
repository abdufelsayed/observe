  (pps observe.ppx)))

(executable
 (name ppx_driver)
 (modules ppx_driver)
 (libraries ppxlib observe.ppx))

(executable
 (name check_inline_expansion)
 (modules check_inline_expansion)
 (libraries ppxlib))

(rule
 (alias observe-ppx-semantics)
 (package observe)
 (deps
  test_deriver_semantics.exe
  test_value_semantics.exe
  test_logging_semantics.exe
  ppx_compile_surface.exe
  inline_signature.exe
  wide_compile_surface.exe)
 (action
  (progn
   (run %{exe:test_deriver_semantics.exe})
   (run %{exe:test_value_semantics.exe})
   (run %{exe:test_logging_semantics.exe})
   (run %{exe:ppx_compile_surface.exe})
   (run %{exe:inline_signature.exe})
   (run %{exe:wide_compile_surface.exe}))))

(rule
 (alias observe-ppx-negative)
 (package observe)
 (deps
  check_negative.sh
  value_unsupported.ml
  value_suffixed_integer.ml
  value_record_update.ml
  logging_unknown_form.ml
  logging_typed_without_schema.ml
  logging_reserved_field.ml
  logging_typed_reserved_field.ml
  wide_error_missing_using.ml
  wide_redundant_untyped.ml
  untyped_nested_value.ml.fail
  untyped_dynamic.ml
  deriver_abstract.ml
  deriver_gadt.ml
  deriver_open_polyvariant.ml
  ppx_driver.exe)
 (action
  (progn
   (run
    bash
    %{dep:check_negative.sh}
    %{exe:ppx_driver.exe}
    %{dep:value_unsupported.ml}
    "[%observe.value]: unsupported expression")
   (run
    bash
    %{dep:check_negative.sh}
    %{exe:ppx_driver.exe}
    %{dep:value_suffixed_integer.ml}
    "[%observe.value]: suffixed integer literals require")
   (run
    bash
    %{dep:check_negative.sh}
    %{exe:ppx_driver.exe}
    %{dep:value_record_update.ml}
    "[%observe.value]: record updates are not valid untyped objects")
   (run
    bash
    %{dep:check_negative.sh}
    %{exe:ppx_driver.exe}
    %{dep:logging_unknown_form.ml}
    "[%observe.info]: expected [text ...], [untyped { ... }], [typed ~using value], or [error ~using:interpretation value]")
   (run
    bash
    %{dep:check_negative.sh}
    %{exe:ppx_driver.exe}
    %{dep:logging_typed_without_schema.ml}
    "[%observe.info]: [typed] requires [~using] and one value")
   (run
    bash
    %{dep:check_negative.sh}
    %{exe:ppx_driver.exe}
    %{dep:logging_reserved_field.ml}
    "[%observe.info]: field [service] is reserved for Observe metadata")
   (run
    bash
    %{dep:check_negative.sh}
    %{exe:ppx_driver.exe}
    %{dep:logging_typed_reserved_field.ml}
    "[%observe.info]: field [service] is reserved for Observe metadata")
   (run
    bash
    %{dep:check_negative.sh}
    %{exe:ppx_driver.exe}
    %{dep:wide_error_missing_using.ml}
    "[%observe.set]: [error] requires [~using], an optional [~backtrace], and one value")
   (run
    bash
    %{dep:check_negative.sh}
    %{exe:ppx_driver.exe}
    %{dep:wide_redundant_untyped.ml}
    "[%observe.set]: expected [handle { ... }], [handle typed { ... }], or [handle error ~using:interpretation value]")
   (run
    bash
    %{dep:check_negative.sh}
    %{exe:ppx_driver.exe}
    %{dep:untyped_nested_value.ml.fail}
    "[untyped] requires one anonymous object")
   (run
    bash
    %{dep:check_negative.sh}
    %{exe:ppx_driver.exe}
    %{dep:untyped_dynamic.ml}
    "[%observe.info]: unsupported expression")
   (run
    bash
    %{dep:check_negative.sh}
    %{exe:ppx_driver.exe}
    %{dep:deriver_abstract.ml}
    "abstract types need a manifest")
   (run
    bash
    %{dep:check_negative.sh}
    %{exe:ppx_driver.exe}
    %{dep:deriver_gadt.ml}
    "GADT result types are not supported")
   (run
    bash
    %{dep:check_negative.sh}
    %{exe:ppx_driver.exe}
    %{dep:deriver_open_polyvariant.ml}
    "open polymorphic variants are not supported"))))

(rule
 (alias observe-ppx-negative)
 (package observe)
 (enabled_if
  (>= %{ocaml_version} 5.2))
 (deps check_negative.sh deriver_local_open.ml ppx_driver.exe)
 (action
  (run
   bash
   %{dep:check_negative.sh}
   %{exe:ppx_driver.exe}
   %{dep:deriver_local_open.ml}
   "locally opened types are not supported")))

(rule
 (alias observe-ppx-negative)
 (package observe)
 (deps
  check_compile_negative.sh
  typed_scalar_root.ml.fail
  typed_variant_root.ml.fail
  typed_unknown_field.ml.fail
  typed_wrong_field_value.ml.fail
  typed_different_schema.ml.fail
  untyped_wrong_description.ml.fail
  ppx_driver.exe
  %{lib:observe:observe.cmi})
 (action
  (progn
   (run
    bash
    %{dep:check_compile_negative.sh}
    %{bin:ocamlfind}
    %{exe:ppx_driver.exe}
    %{lib:observe:observe.cmi}
    %{dep:typed_scalar_root.ml.fail}
    "Observe.Schema.t")
   (run
    bash
    %{dep:check_compile_negative.sh}
    %{bin:ocamlfind}
    %{exe:ppx_driver.exe}
    %{lib:observe:observe.cmi}
    %{dep:typed_variant_root.ml.fail}
    "Observe.Schema.t")
   (run
    bash
    %{dep:check_compile_negative.sh}
    %{bin:ocamlfind}
    %{exe:ppx_driver.exe}
    %{lib:observe:observe.cmi}
    %{dep:typed_unknown_field.ml.fail}
    "__observe_field_missing")
   (run
    bash
    %{dep:check_compile_negative.sh}
    %{bin:ocamlfind}
    %{exe:ppx_driver.exe}
    %{lib:observe:observe.cmi}
    %{dep:typed_wrong_field_value.ml.fail}
    "expected of type")
   (run
    bash
    %{dep:check_compile_negative.sh}
    %{bin:ocamlfind}
    %{exe:ppx_driver.exe}
    %{lib:observe:observe.cmi}
    %{dep:typed_different_schema.ml.fail}
    "first Observe.Schema.patch")
   (run
    bash
    %{dep:check_compile_negative.sh}
    %{bin:ocamlfind}
    %{exe:ppx_driver.exe}
    %{lib:observe:observe.cmi}
    %{dep:untyped_wrong_description.ml.fail}
    "expected of type"))))

(rule
 (alias observe-ppx-expansion)
 (target inline_expansion.actual)
 (deps inline_expansion.ml ppx_driver.exe check_inline_expansion.exe)
 (action
  (progn
   (with-stdout-to
    %{target}
    (run %{exe:ppx_driver.exe} --impl %{dep:inline_expansion.ml}))
   (run %{exe:check_inline_expansion.exe} %{target}))))

(rule
 (alias observe-ppx-expansion)
 (target recursive_expansion.actual)
 (deps recursive_expansion.ml ppx_driver.exe check_inline_expansion.exe)
 (action
  (progn
   (with-stdout-to
    %{target}
    (run %{exe:ppx_driver.exe} --impl %{dep:recursive_expansion.ml}))
   (run %{exe:check_inline_expansion.exe} %{target} recursive))))

(rule
 (alias observe-ppx-expansion)
 (target logging_expansion.actual)
 (deps logging_expansion.ml ppx_driver.exe check_inline_expansion.exe)
 (action
  (progn
   (with-stdout-to
    %{target}
    (run %{exe:ppx_driver.exe} --impl %{dep:logging_expansion.ml}))
   (run %{exe:check_inline_expansion.exe} %{target} logging))))

(alias
 (name observe-ppx-contracts)
 (package observe)
 (deps
  (alias observe-ppx-semantics)
  (alias observe-ppx-negative)
  (alias observe-ppx-expansion)))
