(executable
 (name test_deriver_semantics)
 (modules test_deriver_semantics)
 (libraries observe alcotest)
 (preprocess
  (pps observe.ppx)))

(executable
 (name test_value_semantics)
 (modules test_value_semantics)
 (libraries observe observe_test_support alcotest)
 (preprocess
  (pps observe.ppx)))

(executable
 (name ppx_compile_surface)
 (modules ppx_compile_surface)
 (libraries observe)
 (preprocess
  (pps observe.ppx)))

(executable
 (name inline_signature)
 (modules inline_signature)
 (libraries observe)
 (preprocess
  (pps observe.ppx)))

(executable
 (name ppx_driver)
 (modules ppx_driver)
 (libraries ppxlib observe.ppx))

(executable
 (name check_inline_expansion)
 (modules check_inline_expansion)
 (libraries ppxlib))

(rule
 (alias observe-ppx-semantics)
 (package observe)
 (deps
  test_deriver_semantics.exe
  test_value_semantics.exe
  ppx_compile_surface.exe
  inline_signature.exe)
 (action
  (progn
   (run %{exe:test_deriver_semantics.exe})
   (run %{exe:test_value_semantics.exe})
   (run %{exe:ppx_compile_surface.exe})
   (run %{exe:inline_signature.exe}))))

(rule
 (alias observe-ppx-negative)
 (package observe)
 (deps
  check_negative.sh
  value_unsupported.ml
  value_suffixed_integer.ml
  value_record_update.ml
  deriver_abstract.ml
  deriver_gadt.ml
  deriver_open_polyvariant.ml
  ppx_driver.exe)
 (action
  (progn
   (run
    bash
    %{dep:check_negative.sh}
    %{exe:ppx_driver.exe}
    %{dep:value_unsupported.ml}
    "[%observe.value]: unsupported expression")
   (run
    bash
    %{dep:check_negative.sh}
    %{exe:ppx_driver.exe}
    %{dep:value_suffixed_integer.ml}
    "[%observe.value]: suffixed integer literals require")
   (run
    bash
    %{dep:check_negative.sh}
    %{exe:ppx_driver.exe}
    %{dep:value_record_update.ml}
    "[%observe.value]: record updates are not valid free-form objects")
   (run
    bash
    %{dep:check_negative.sh}
    %{exe:ppx_driver.exe}
    %{dep:deriver_abstract.ml}
    "abstract types need a manifest")
   (run
    bash
    %{dep:check_negative.sh}
    %{exe:ppx_driver.exe}
    %{dep:deriver_gadt.ml}
    "GADT result types are not supported")
   (run
    bash
    %{dep:check_negative.sh}
    %{exe:ppx_driver.exe}
    %{dep:deriver_open_polyvariant.ml}
    "open polymorphic variants are not supported"))))

(rule
 (alias observe-ppx-expansion)
 (target inline_expansion.actual)
 (deps inline_expansion.ml ppx_driver.exe check_inline_expansion.exe)
 (action
  (progn
   (with-stdout-to
    %{target}
    (run %{exe:ppx_driver.exe} --impl %{dep:inline_expansion.ml}))
   (run %{exe:check_inline_expansion.exe} %{target}))))

(rule
 (alias observe-ppx-expansion)
 (target recursive_expansion.actual)
 (deps recursive_expansion.ml ppx_driver.exe check_inline_expansion.exe)
 (action
  (progn
   (with-stdout-to
    %{target}
    (run %{exe:ppx_driver.exe} --impl %{dep:recursive_expansion.ml}))
   (run %{exe:check_inline_expansion.exe} %{target} recursive))))

(alias
 (name observe-ppx-contracts)
 (package observe)
 (deps
  (alias observe-ppx-semantics)
  (alias observe-ppx-negative)
  (alias observe-ppx-expansion)))
