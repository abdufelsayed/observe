(executable
 (name concurrency_scenario)
 (modules concurrency_scenario)
 (libraries observe observe_test_support alcotest threads.posix unix))

(rule
 (alias observe-concurrency-smoke)
 (package observe)
 (deps concurrency_scenario.exe)
 (action
  (progn
   (run %{exe:concurrency_scenario.exe} init-race 2)
   (run %{exe:concurrency_scenario.exe} init-race 8)
   (run %{exe:concurrency_scenario.exe} capture-conservation 1 1)
   (run %{exe:concurrency_scenario.exe} capture-conservation 8 1)
   (run %{exe:concurrency_scenario.exe} capture-conservation 64 32)
   (run %{exe:concurrency_scenario.exe} capture-conservation 64 64)
   (run %{exe:concurrency_scenario.exe} capture-conservation 64 67)
   (run %{exe:concurrency_scenario.exe} diagnostic-counting 1)
   (run %{exe:concurrency_scenario.exe} diagnostic-counting 8)
   (run %{exe:concurrency_scenario.exe} diagnostic-counting 64)
   (run %{exe:concurrency_scenario.exe} wide-contribution-and-seal 8)
   (run %{exe:concurrency_scenario.exe} wide-contribution-and-seal 64)
   (run %{exe:concurrency_scenario.exe} wide-set-level-emit-race 8)
   (run %{exe:concurrency_scenario.exe} wide-set-level-emit-race 64)
   (run %{exe:concurrency_scenario.exe} wide-authoring-linearization)
   (run %{exe:concurrency_scenario.exe} wide-parallel-materialization)
   (run %{exe:concurrency_scenario.exe} terminal-race 8)
   (run %{exe:concurrency_scenario.exe} terminal-race 64))))

(rule
 (alias observe-concurrency-stress)
 (package observe)
 (deps
  concurrency_scenario.exe
  run_stress.sh
  (env_var OBSERVE_RACE_TRIALS)
  (env_var OBSERVE_CONCURRENCY_WORK))
 (action
  (run bash %{dep:run_stress.sh} %{exe:concurrency_scenario.exe})))

(alias
 (name discovery)
 (package observe)
 (deps
  (alias observe-concurrency-stress)))
