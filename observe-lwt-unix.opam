# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Ready Lwt-Unix composition for Observe"
description:
  "Ready Observe initialization and scoped capture for Lwt programs on Unix."
maintainer: ["Abdullah Elsayed <hey@abdufelsayed.dev>"]
authors: ["Abdullah Elsayed <hey@abdufelsayed.dev>"]
license: "MIT"
homepage: "https://github.com/abdufelsayed/observe"
doc: "https://abdufelsayed.github.io/observe/"
bug-reports: "https://github.com/abdufelsayed/observe/issues"
depends: [
  "dune" {>= "3.22"}
  "ocaml" {>= "4.14"}
  "observe" {= version}
  "observe-lwt" {= version}
  "lwt"
  "ptime"
  "mtime"
  "ocamlfind" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/abdufelsayed/observe.git"
x-maintenance-intent: ["(latest)"]
